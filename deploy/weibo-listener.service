# 微博待审评论监听 —— systemd 单元模板
#
# 别直接拷到 /etc/systemd/system/：下面的 @...@ 是占位符，要用本机实际值替换
# （项目根、node 绝对路径、运行用户/组）。deploy/install-systemd.sh 会做这件事，
# 手工安装就照着替换这 4 个占位符。
#
# Linux 上只能靠 systemd：程序自带的 --install 走的是 Windows 的 schtasks
# （src/schedule.js），在 Linux 上执行它什么都不会发生。

[Unit]
Description=WeiBoListener - 微博待审评论监听

# 第一轮启动就要访问 weibo.com 与 wxpusher.zjiecode.com，等网络就绪再起，
# 否则开机会先白失败一轮（不影响后续轮询，但会平白多一条告警）。
After=network-online.target
Wants=network-online.target

# 崩溃拉起的上限（配合下面的 Restart=always）。
# 有些启动失败不是「等一下就好」，而是「改配置才能好」：
#   缺 WEIBO_COOKIE（src/index.js:284）、缺 WxPusher 配置（:299）、
#   config.json 不存在或不合法、data/.lock 被另一个实例占着。
# 这些情况下程序每次启动都会立刻 exit 1，Restart=always 会把它们变成死循环：
# 既刷爆 journald，也会让 logs/app-YYYY-MM-DD.log（程序不轮转日志）一天涨出几 MB 重复行。
# 所以限制成「600 秒内最多起 6 次」，超了让单元进入 failed 停下、日志留着原因。
# 修好配置后手动恢复：
#   systemctl reset-failed weibo-listener && systemctl start weibo-listener
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory="@PROJECT_ROOT@"

# node 用绝对路径：systemd 不读 .bashrc，PATH 里也没有 nvm 的 shim。
# 升级/切换 node 后路径可能会变，重跑一次 install-systemd.sh 让它重新探测。
# 相对路径 src/index.js 是相对 WorkingDirectory 的；程序靠 import.meta.url
# 反推项目根，所以 .env、config.json、data/、logs/ 都落在 WorkingDirectory 下。
ExecStart="@NODE_BIN@" "src/index.js"

# 日志文件名里的日期、心跳小时（heartbeatHour）都按本地时间算，
# 服务器默认 UTC 会让心跳差 8 小时、日志文件跨天错位，必须设。
Environment=TZ=Asia/Shanghai
# 刻意不设 Environment=NODE_ENV=production：程序里没有任何地方读 NODE_ENV
# （src/ 下只读 WEIBO_COOKIE、WXPUSHER_*、LOG_LEVEL 和各站点的 SITE_*_COOKIE），
# 设了只会让人误以为存在「生产模式」开关。

# 程序自己的 logger 同时写 logs/app-YYYY-MM-DD.log 和 stdout/stderr（src/logger.js），
# 所以 journald 里也有一份同样的内容：
#   journalctl 那份用于 systemctl status / 排障、能看崩溃前的输出；
#   logs/ 那份是完整历史，程序不清理旧日志（见 deploy/README.md 的日志轮转）。
StandardOutput=journal
StandardError=journal

# 定时轮询服务不存在「正常退出」：崩溃、exit(1)，甚至意外 exit(0) 都应该拉起来。
Restart=always
# 比轮询间隔（默认 300 秒）短得多；又不至于配置写错时每秒重启一次。
# 真正的兜底是上面的 StartLimitIntervalSec / StartLimitBurst。
RestartSec=30

# 停服必须走 SIGTERM：程序在 SIGTERM 处理里 releaseLock() 删掉 data/.lock（src/index.js:343-347）。
# 锁没删掉，下次启动会认成「已有实例在运行（PID xxx）」而拒绝启动。
KillSignal=SIGTERM
# 程序正常 1 秒内就退（记一行日志、删锁、退出前那次 saveState），30 秒是给慢盘/卡住的 fs 留的余量。
# 真超时了 systemd 会补一刀 SIGKILL；留下的 .lock 不会卡死后续启动：
# 下次启动发现里面的 PID 已不存在，会当残留锁覆盖（src/lock.js）。
TimeoutStopSec=30

# ---------------- 加固：只开了对本程序确定安全的项 ----------------
NoNewPrivileges=yes
# 私有 /tmp：程序不依赖宿主机上的任何临时文件
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# 整个文件系统只读，再用 ReadWritePaths 单独放开项目目录：
# .env / config.json 只需读；data/（state.json、state.json.bak、.lock）和 logs/ 需要写，
# 两者都在项目根下，所以放开项目根一处就够。日志目录若在 config.json 里改成别处，
# 记得把那个路径也加进 ReadWritePaths。
ProtectSystem=strict
ReadWritePaths="@PROJECT_ROOT@"
# 故意没开 ProtectHome=yes：项目很可能就放在 /home/<用户>/ 下，开了会连代码和 .env 都读不到。
# 项目不在 /home 下的话可以取消注释：
# ProtectHome=yes
# 只放行 IPv4/IPv6 和本地 socket（DNS 走 systemd-resolved 的 socket 时需要 AF_UNIX）。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# 新写出的文件收紧一点：data/ 里只有状态和锁，没必要给 other 读。
# 注意：用配置面板时最好也用同一个运行用户启动（见 README），否则面板读不到 .lock。
UMask=0027
# 刻意没开的两项，开了会直接把服务弄坏：
#   MemoryDenyWriteExecute=yes —— V8 的 JIT 需要可写可执行内存，开了 node 立刻崩
#   SystemCallFilter=@system-service —— node 用到的个别较新 syscall 可能不在白名单里

# 这一段是 systemctl enable 的依据：没有它，enable 会报
# "The unit files have no installation config"，服务不会开机自启。
[Install]
WantedBy=multi-user.target
