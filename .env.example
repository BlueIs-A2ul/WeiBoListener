# 微博 Cookie：从浏览器开发者工具复制整行 Cookie
WEIBO_COOKIE=

# WxPusher 应用 Token（在 wxpusher.zjiecode.com 创建应用后获取）
WXPUSHER_APP_TOKEN=

# WxPusher 用户 UID，多个用英文逗号分隔
WXPUSHER_UIDS=

# 可选：debug / info / warn / error
LOG_LEVEL=info

# 通用站点 Cookie（config.json 里 sites[].request.cookieEnv 指向这些键名）
# 键名规则：SITE_<站点 ID 大写、短横线换成下划线>_COOKIE
# SITE_EXAMPLE_EXAMS_COOKIE=
